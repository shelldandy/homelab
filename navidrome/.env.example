# https://www.navidrome.org/docs/usage/configuration-options/#available-options
TZ=America/Mexico_City
SUBDOMAIN=music

# Path to your media files
MEDIA_SHARE=/mnt/media-merged/share
# Path for the config files
BASE_PATH=/mnt/docker-data
NAVIDROME_DATA=/mnt/docker-data

# For Last.fm integration
ND_LASTFM_APIKEY=
ND_LASTFM_SECRET=

# Read this before enabling
# early development feature
# https://www.navidrome.org/docs/usage/sharing/#enabling-the-sharing-feature
# ND_ENABLESHARING=true

# Prometheus integration
# https://www.navidrome.org/docs/usage/monitoring/
# ND_PROMETHEUS_ENABLED=true
# ND_PROMETHEUS_METRICSPATH="/metrics"

# SpotiFLAC Server (web UI)
SPOTIFLAC_SUBDOMAIN=spotiflac

# SpotiFLAC Telegram Bot
SPOTIFLAC_TELEGRAM_TOKEN=       # from @BotFather
SPOTIFLAC_SPOTIFY_CLIENT_ID=    # from developer.spotify.com/dashboard
SPOTIFLAC_SPOTIFY_CLIENT_SECRET= # from developer.spotify.com/dashboard
SPOTIFLAC_ALLOWED_USER_IDS=     # comma-separated Telegram user IDs (empty = open to all)

## YUBAL START
# YouTube / YouTube Music downloader. Writes tagged files directly into the
# Navidrome library (bypasses beets). Web UI subdomain:
YUBAL_SUBDOMAIN=ytmdl
# Scheduled playlist sync (unquoted - see .env notes)
YUBAL_SCHEDULER_CRON=0 4 * * *
# Optional: for Premium quality (256kbps), private playlists and Liked Music,
# place a Netscape-format cookies.txt at:
#   ${BASE_PATH}/yubal/config/ytdlp/cookies.txt
# or upload it via the web UI. Treat it as a credential - never commit it.
## YUBAL END
