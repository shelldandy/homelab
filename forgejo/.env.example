# openssl rand -base64 32
SUBDOMAIN=forgejo
DB_NAME=forgejo
DB_USER=admin
DB_PWD=
CONFIG_PATH=./data
# set this to true to auto-create accounts for new Pocket ID users
# the Pocket ID auth source itself is added in-app:
# Site Administration > Authentication Sources > OAuth2 (OpenID Connect)
ENABLE_AUTO_REGISTRATION=false
# this is OpenID 2.0, unrelated to Pocket ID OIDC - leave false
ENABLE_OPENID_SIGNIN=false
# comma-separated hosts webhooks may target, e.g. external,loopback
ALLOWED_HOST_LIST=external,loopback
# true routes all git traffic over HTTPS instead of SSH
DISABLE_SSH=false
