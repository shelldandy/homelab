TZ=America/Mexico_City
CONFIG_PATH=/mnt/docker-data/spraywall

SUBDOMAIN=muro
SPRAYWALL_VERSION=edge

# Generate each secret with: openssl rand -hex 32
POSTGRES_DB=spraywall
POSTGRES_USER=spraywall
POSTGRES_PASSWORD=
MINIO_BUCKET=spraywall
MINIO_ROOT_USER=spraywall
MINIO_ROOT_PASSWORD=
JWT_SECRET=

# Pocket ID OIDC client (callback: https://muro.bowline.im/api/auth/oidc/callback)
SPRAYWALL_OIDC_CLIENT_ID=
SPRAYWALL_OIDC_CLIENT_SECRET=
SPRAYWALL_OIDC_ADMIN_GROUP=spraywall-admins
# Set to false once SSO works (SSO-only)
PASSWORD_LOGIN_ENABLED=true
