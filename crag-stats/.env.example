SUBDOMAIN=cragstats
CONFIG_PATH=/mnt/docker-data/crag-stats
CRAG_STATS_IMAGE_TAG=latest
TZ=America/Mexico_City

# Required: generate with `openssl rand -hex 32` and keep this value stable.
SESSION_SECRET=

# Optional: grants read access to your theCrag logbook, including private notes.
# Leave blank to import theCrag CSV exports manually in Settings.
THECRAG_API_KEY=

# Optional app-level password; Traefik OIDC protects the full site by default.
APP_PASSWORD=
AUTH_SCOPE=settings

# Optional: route metadata and weather imports are disabled unless enabled.
# ROUTE_DATA_IMPORT=false
# WEATHER_IMPORT=false
