TZ=America/Mexico_City
PUID=1000
PGID=1000
CONFIG_PATH=/path/to/config
MEDIA_SHARE=/path/to/media

# BookLore
BOOKLORE_SUBDOMAIN=books
BOOKLORE_DB_USER=booklore
BOOKLORE_DB_PASSWORD=changeme
BOOKLORE_DB_ROOT_PASSWORD=changeme
#
# bookdl
BOOKLORE_USERNAME=bowlinedandy
BOOKLORE_PASSWORD=
CALIBRE_WEB_DL_SUBDOMAIN=bookdl
AA_DONATOR_KEY=
AA_MIRROR_URLS="https://annas-archive.gl, https://annas-archive.pk, https://annas-archive.gd"
BOOKDL_OIDC_CLIENT_ID=
BOOKDL_OIDC_CLIENT_SECRET=
#
# crossbill
CROSSBILL_SUBDOMAIN=crossbill
CROSSBILL_DB_USER=crossbill
CROSSBILL_DB_PASSWORD=changeme
# JWT signing secrets. Both required - the backend refuses to start if either
# is empty or shorter than 32 bytes, and they must differ from each other.
# Generate each with: openssl rand -hex 32
CROSSBILL_SECRET_KEY=
CROSSBILL_REFRESH_TOKEN_SECRET_KEY=
# Consumed only on first startup to provision the initial admin user.
# Rejected if empty or set to the literal "admin". Crossbill has no OIDC, so
# this password is the real security boundary - openssl rand -base64 24
CROSSBILL_ADMIN_USERNAME=admin
CROSSBILL_ADMIN_PASSWORD=
# Temporarily set true to verify TRUSTED_PROXY_HOPS against what Traefik sends
# CROSSBILL_LOG_PROXY_CHAIN=false
